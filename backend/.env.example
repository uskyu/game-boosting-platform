# Game Boosting Platform Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration (MySQL 8.0)
# Format: mysql+aiomysql://user:password@host:port/database
DB_URL=mysql+aiomysql://boosting_user:your_secure_password@localhost:3306/game_boosting

# API process connection pool.  Browsers keep a WebSocket to the API; only
# short database operations borrow a connection from this shared pool.
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1200
DB_CONNECT_TIMEOUT=5
DB_HEALTH_TIMEOUT=3

# DeepSeek API Configuration
# Get your API key from DeepSeek dashboard
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Security Configuration
# Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here_change_in_production

# JWT Configuration (Optional - defaults provided)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Application Configuration (Optional - defaults provided)
APP_NAME=Game Boosting Platform
DEBUG=false
API_V1_PREFIX=/api/v1

# Bootstrap admin account (auto-created on startup if not exists)
DEFAULT_ADMIN_EMAIL=admin@gameboost.com
DEFAULT_ADMIN_USERNAME=SystemAdmin
DEFAULT_ADMIN_PASSWORD=Admin123456

# 首次部署初始化站点设置时的注册默认权限（仅在 site_settings 行不存在时生效，
# 之后管理员的修改不会因重启被覆盖）。
# 生产站保持 true（注册即可发单/接单）；新站可设
# REGISTRATION_DEFAULT_CAN_PUBLISH=false，让新用户默认只能接单，
# 发单需管理员开通或用户自助申请后审核。
REGISTRATION_DEFAULT_CAN_PUBLISH=true
REGISTRATION_DEFAULT_CAN_ACCEPT=true
PUBLISH_PERMISSION_APPLY_ENABLED=true

# Upload directory for booster proof screenshots
UPLOAD_DIR=uploads

PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
