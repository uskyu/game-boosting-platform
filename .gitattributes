# 统一换行符策略：避免 Windows 开发机（core.autocrlf=true）把容器内执行的
# 脚本提交成 CRLF。CRLF 的 shell 脚本进入 Linux 容器后会报
# "/bin/sh^M: bad interpreter"，整个后端将无法启动。
*.sh            text eol=lf
*.bash          text eol=lf
docker-entrypoint.sh  text eol=lf

# 其余文本文件在仓库内统一用 LF，检出时按各平台习惯。
*.py            text eol=lf
*.js            text eol=lf
*.vue           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.sql           text eol=lf
*.conf          text eol=lf
*.cfg           text eol=lf
*.ini           text eol=lf
*.txt           text eol=lf
Dockerfile      text eol=lf

# 二进制资源不做换行符转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.wav           binary
*.mp3           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.pdf           binary
*.zip           binary
*.gz            binary
